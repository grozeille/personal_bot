<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TabletApp</AssemblyName>
    <RootNamespace>TabletApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <UserSecretsId>2845a56a-79cc-4c30-b8b0-654897b03861</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modèle wake word embarqué (~5 Mo) : publié et installé via Velopack. -->
    <Content Include="Models\kws\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Models\audio\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Bibliothèque de gestes tête (play_gesture) : publiée et installée via Velopack. -->
    <Content Include="Gestures\gestures.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Skills chargeables (tool load_skill) : publiées et installées via Velopack. -->
    <Content Include="Skills\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Pokédex local (tool search_pokemon) : publié et installé via Velopack. -->
    <Content Include="Data\pokedex.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabletApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\faces\parts\*.svg">
      <LogicalName>TabletApp.Faces.Parts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\icons\*.svg">
      <LogicalName>TabletApp.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\uno-atlas\atlas.png">
      <LogicalName>TabletApp.UnoAtlas.atlas.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\uno-atlas\atlas.json">
      <LogicalName>TabletApp.UnoAtlas.atlas.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.157.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.2" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" Version="2.0.2" />
  </ItemGroup>

</Project>
