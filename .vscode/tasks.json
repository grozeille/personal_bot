{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "publish win-x86 (Release)",
      "detail": "Produit l'exe 32 bits auto-contenu pour la tablette.",
      "type": "shell",
      "command": "dotnet publish ${workspaceFolder}/src/TabletApp/TabletApp.csproj -c Release -r win-x86 --self-contained",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build (Debug)",
      "detail": "Compilation rapide pour le développement sur PC.",
      "type": "shell",
      "command": "dotnet build ${workspaceFolder}/src/TabletApp/TabletApp.csproj -c Debug",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run (Debug)",
      "detail": "Lance l'app sur ce PC (fenêtre plein écran).",
      "type": "shell",
      "command": "dotnet run --project ${workspaceFolder}/src/TabletApp/TabletApp.csproj -c Debug",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
